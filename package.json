{
  "name": "remarca-backend",
  "version": "1.0.0",
  "description": "Plataforma de Agendamento Médico - Backend Serverless",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "sam:build": "sam build",
    "sam:deploy:dev": "sam deploy --config-env dev",
    "sam:deploy:prod": "sam deploy --config-env production"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "healthcare",
    "appointments"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.490.0",
    "@aws-sdk/client-dynamodb": "^3.490.0",
    "@aws-sdk/client-ses": "^3.490.0",
    "@aws-sdk/lib-dynamodb": "^3.490.0",
    "aws-jwt-verify": "^4.0.1",
    "googleapis": "^131.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.133",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "eslint": "^8.56.0",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
